{
  "name": "dsh-wallpaper-lab",
  "version": "0.3.0",
  "description": "给 DeepSeek Harness (dsh) Web 界面换动态壁纸：视频 / 图片 / 跟随桌面，内置素材下载，控制条可收起。A live-wallpaper plugin for the dsh web GUI.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaoKashj/dsh-wallpaper-lab.git"
  },
  "homepage": "https://github.com/KaoKashj/dsh-wallpaper-lab#readme",
  "bugs": {
    "url": "https://github.com/KaoKashj/dsh-wallpaper-lab/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wallpaper",
    "live-wallpaper",
    "dsh-plugin"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
